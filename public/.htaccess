# Dog Breeds & Needs — Apache config for HostGator shared hosting.
# Upload the CONTENTS of dist/ (including this file) into the domain's folder, e.g. public_html.

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. One canonical host: https://dogbreedsandneeds.com (no www)
#    Leave this on only once HostGator's free SSL (AutoSSL) shows as active.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dogbreedsandneeds.com%{REQUEST_URI} [L,R=301]

# 2. Old URLs from the Replit version
RewriteRule ^poodle-rescue/?$ /rescue/poodle [L,R=301]
RewriteRule ^quiz/?$ /dog-breed-selector [L,R=301]
RewriteRule ^breeds/([a-z0-9-]+)\.png$ /breeds/$1.webp [L,R=301]
RewriteRule ^attached_assets/stock_images/([a-z_]+)\.jpg$ /images/products/$1.webp [L,R=301]
RewriteRule ^og-default\.png$ /og-default.jpg [L,R=301]
RewriteRule ^admin/?$ / [L,R=301]

# 3. Remove trailing slashes and ".html" so every page has one URL
RewriteRule ^(.+)/$ /$1 [L,R=301]
RewriteCond %{THE_REQUEST} \s/([^?\s]*?)(index)?\.html[?\s]
RewriteRule ^ /%1 [L,R=301]

# 4. Serve /breeds/labrador-retriever from breeds/labrador-retriever.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_mime.c>
AddType image/webp .webp
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
# CSS/JS file names change whenever their content changes, so they can be cached for a year
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(webp|jpg|png|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|json|xml|txt)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
